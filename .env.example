# Server-side only — read by the Vercel Functions in /api. NEVER prefix these with VITE_ (that would bundle them into the public client build).

# Anthropic API key — used by /api/chat (the AI assistant proxy).
ANTHROPIC_API_KEY=your-anthropic-key

# Resend — used by /api/inquiry to deliver contact and careers submissions.
# In production/preview, RESEND_API_KEY is injected automatically by the Vercel Resend integration; set it locally for dev.
RESEND_API_KEY=your-resend-key

# Inbox that inquiries are delivered to.
INQUIRY_TO_EMAIL=inquiries@glovermastpurl.com

# Sender address (must be on a Resend-verified domain). Falls back to onboarding@resend.dev if unset.
INQUIRY_FROM_EMAIL=inquiries@glovermastpurl.com
